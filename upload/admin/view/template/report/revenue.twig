{{ header }}
{{ column_left }}

<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">{{ text_filter }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="get" class="form-inline">
          <input type="hidden" name="route" value="report/revenue" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />

          <div class="form-group">
            <label>{{ entry_date_start }}</label>
            <input type="date" name="filter_start" value="{{ filter_start }}" class="form-control" />
          </div>

          <div class="form-group">
            <label>{{ entry_date_end }}</label>
            <input type="date" name="filter_end" value="{{ filter_end }}" class="form-control" />
          </div>

          <div class="form-group">
            <label>{{ entry_status }}</label>
            <input type="number" name="status_id" value="{{ status_id }}" class="form-control" style="width:100px" />
            <small class="text-muted">ID trạng thái (ví dụ: 5 = Completed)</small>
          </div>

          <button type="submit" class="btn btn-primary">{{ button_filter }}</button>
        </form>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-12 col-md-8">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title">Doanh thu theo ngày</h3></div>
          <div class="panel-body">
            <canvas id="chartDays" height="120"></canvas>
          </div>
        </div>

        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title">Doanh thu theo tháng</h3></div>
          <div class="panel-body">
            <canvas id="chartMonths" height="120"></canvas>
          </div>
        </div>
      </div>

      <div class="col-sm-12 col-md-4">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title">Top sản phẩm bán chạy</h3></div>
          <div class="panel-body">
            <table class="table table-striped">
              <thead>
                <tr><th>#</th><th>{{ column_product }}</th><th>{{ column_quantity }}</th><th>{{ column_total }}</th></tr>
              </thead>
              <tbody>
                {% for product in top_products %}
                <tr>
                  <td>{{ loop.index }}</td>
                  <td>{{ product.name }}</td>
                  <td>{{ product.quantity }}</td>
                  <td>{{ product.revenue }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4">Không có dữ liệu</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title">Top khách hàng mua nhiều</h3></div>
          <div class="panel-body">
            <table class="table table-striped">
              <thead>
                <tr><th>#</th><th>{{ column_customer }}</th><th>{{ column_orders }}</th><th>{{ column_total }}</th></tr>
              </thead>
              <tbody>
                {% for customer in top_customers %}
                <tr>
                  <td>{{ loop.index }}</td>
                  <td>{{ customer.name }}</td>
                  <td>{{ customer.orders }}</td>
                  <td>{{ customer.total }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4">Không có dữ liệu</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

{{ footer }}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
  const days = JSON.parse('{{ chart_days|e('js') }}');
  const revenueDays = JSON.parse('{{ chart_revenue_days|e('js') }}');
  const months = JSON.parse('{{ chart_months|e('js') }}');
  const revenueMonths = JSON.parse('{{ chart_revenue_months|e('js') }}');


  function numberWithCommas(x) {
    return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  }

  // Days chart
  const ctxDays = document.getElementById('chartDays').getContext('2d');
  new Chart(ctxDays, {
    type: 'line',
    data: {
      labels: days,
      datasets: [{
        label: 'Doanh thu',
        data: revenueDays,
        fill: false,
        tension: 0.1
      }]
    },
    options: {
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) { return numberWithCommas(value); }
          }
        }
      },
      plugins: {
        tooltip: {
          callbacks: {
            label: function(context) {
              return 'Doanh thu: ' + numberWithCommas(context.parsed.y);
            }
          }
        }
      }
    }
  });

  // Months chart
  const ctxMonths = document.getElementById('chartMonths').getContext('2d');
  new Chart(ctxMonths, {
    type: 'bar',
    data: {
      labels: months,
      datasets: [{
        label: 'Doanh thu',
        data: revenueMonths,
        barPercentage: 0.6
      }]
    },
    options: {
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) { return numberWithCommas(value); }
          }
        }
      }
    }
  });
})();
</script>
